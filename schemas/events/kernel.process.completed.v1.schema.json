{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paos://schemas/events/kernel.process.completed.v1.schema.json",
  "title": "kernel.process.completed payload",
  "description": "doc 05 §3.1 — Process chuyển sang SUCCEEDED. cost/quality optional ở M0 (chưa có Cost Engine/Review Agent tới M7/M4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["pid", "duration_ms"],
  "properties": {
    "pid": { "type": "integer", "minimum": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "cost": { "type": "number", "minimum": 0 },
    "quality": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
